{
  "name": "poker-game",
  "version": "1.0.0",
  "description": "多人在线德州扑克（Node.js + Socket.IO）",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node test/run-all.js",
    "test:rules": "node test/rules.test.js",
    "test:ui": "node test/ui-content.test.js",
    "test:action-result": "node test/action-result.test.js",
    "test:session-panel": "node test/session-panel.test.js",
    "test:mobile-view": "node test/mobile-view.test.js",
    "test:geometry": "node test/geometry-check.js",
    "test:show-cards": "node test/show-cards.test.js",
    "test:identity": "node test/identity.test.js",
    "test:friends": "node test/friends.test.js",
    "test:chat-delivery": "node test/chat-delivery.test.js",
    "test:lobby-requests": "node test/lobby-requests.test.js",
    "test:room-connection": "node test/room-connection.test.js && node test/room-connection.integration.test.js",
    "test:squid": "node test/squid.test.js",
    "test:mode-config": "node test/mode-config.test.js",
    "test:tournament": "node test/tournament.test.js",
    "test:smoke": "node test/smoke.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^5.2.1",
    "ipaddr.js": "1.9.1",
    "proxy-addr": "2.0.7",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  }
}
