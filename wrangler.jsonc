{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "poker-game",
  "main": "worker.js",
  "compatibility_date": "2026-09-04",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/ws", "/socket.io/*"]
  },
  "observability": {
    "enabled": true
  }
}
