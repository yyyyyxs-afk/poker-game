{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "poker-game",
  "main": "worker.js",
  "compatibility_date": "2026-09-04",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/ws", "/socket.io/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "POKER_HUB", "class_name": "PokerHub" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PokerHub"] }
  ],
  "observability": {
    "enabled": true
  }
}
